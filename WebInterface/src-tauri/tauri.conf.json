{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowViewer",
  "version": "0.1.0",
  "identifier": "com.flow.viewer",
  "build": {
    "frontendDist": "../desktop-shell",
    "devUrl": "http://127.0.0.1:8992",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Flow web console",
    "longDescription": "Desktop window for the Flow web console served by the running application.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
